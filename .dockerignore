# Keep the build context small and the image free of host-specific artifacts.
# Note: docker/backend.Dockerfile deliberately COPYs third_party/ — the xArm SDK
# is a path dependency, so it must stay in the context.

.git/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# host node_modules is macOS-native; the image installs its own
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# secrets and bench-local state (mounted at run time, never baked in)
.env
data/
calib/

# docs and binary exports
*.pptx
.DS_Store
