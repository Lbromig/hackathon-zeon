# Copy to .env and adjust for your bench.  .env is gitignored — never commit it.
#   cp .env.example .env

# --- xArm Lite 6 ---------------------------------------------------------
# IP of the primary (left) arm's control box.
XARM_IP=192.168.3.13
# IP of the second (right) arm. TODO: confirm.
XARM_IP_RIGHT=192.168.3.14
# End-effector: lite6 (pneumatic) | xarm (parallel) | bio | none
XARM_GRIPPER=lite6
# Payload in kg (end-effector + carried labware).
XARM_PAYLOAD_KG=0.5

# --- Fleet ---------------------------------------------------------------
# Optional: path to a JSON file overriding DEFAULT_FLEET in
# backend/app/core/config.py. Leave unset to use the built-in defaults.
#HZ_FLEET_FILE=./fleet.local.json

# --- Opentrons -----------------------------------------------------------
OT_SERIAL_PORT=/dev/ttyACM0

# --- Cameras -------------------------------------------------------------
# OpenCV device indices (or paths / RTSP URLs).
CAM_ON_ARM=0
CAM_EXTERNAL=1

# --- Backend -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
