# Copy to .env and adjust for your bench.  .env is gitignored — never commit it.
#   cp .env.example .env
#
# Every variable below is read by core/config.py (Settings.load). Unset ones fall
# back to the built-in defaults in DEFAULT_FLEET.

# --- xArm Lite 6 ---------------------------------------------------------
# Control-box IP of each arm, keyed by which SIDE of the bench it stands on. When the
# arms get swapped between mounts, swap these two values — the fleet ids (left/right)
# and everything taught against them stay put.
XARM_LEFT_IP=192.168.3.11
XARM_RIGHT_IP=192.168.3.13
# End-effector for both arms: auto | parallel | lite6 | bio | none
# ('auto' picks the API that matches the connected model).
XARM_GRIPPER=auto
# Payload in kg (end-effector + carried labware); drives gravity compensation.
XARM_PAYLOAD_KG=0.5

# --- Opentrons -----------------------------------------------------------
OT_SERIAL_PORT=/dev/ttyACM0

# --- Cameras -------------------------------------------------------------
# WHICH CAMERA IS WHICH VIEWPOINT IS NOT SET HERE — it is hardcoded in core/cameras.py,
# pinned per unit by AVFoundation uniqueID + USB serial.
#
# Why it cannot live in this file: the only thing an env var could hold is a device index,
# and on macOS an index is not an identity. It renumbers on any replug, and measured
# 2026-07-26, between two enumerations seconds apart with nothing touched — the built-in
# MacBook camera moved from index 2 to index 0. Any CAM_<SLOT>=<index> was therefore one
# enumeration away from aiming a viewpoint at another camera, or at the operator, with the
# slot still reporting healthy. Setting CAM_GRIPPER / CAM_GRIPPER_LEFT / CAM_OVERVIEW /
# CAM_HANDOVER now logs a warning and is ignored.
#
# Re-identify the units — prints uniqueIDs, USB serials and one frame per camera:
#   .venv/bin/python scripts/identify_cameras.py --snapshot
# then edit core/cameras.py.
#
# CAM_<SLOT>_TYPE is still honoured, to change the DRIVER behind a viewpoint:
#   avf        UVC pinned by uniqueID  (the default; no root, no depth)
#   realsense  RGB-D via librealsense  (needs root on macOS; pin by the SDK's serial, which
#              differs from the USB serial ioreg prints — a USB one binds nothing, silently)
#   camera     UVC by OpenCV index     (requires CAM_<SLOT> as well, or it is refused: an
#              unset index means device 0, regularly the built-in camera)
#   still      replay a saved frame    (CAM_<SLOT>=<path>, for hardware temporarily away)

# Stream format, applied to every camera. RealSense only accepts
# combinations it has a profile for; 848x480@30 is the safe D4xx default, 1280x720@30
# works on most. Per-camera override by appending the fleet id:
#   CAM_WIDTH_GRIPPER_CAM=848
CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=30

# --- Cameras from another machine ----------------------------------------
# Take EVERY camera feed from another backend instead of from local hardware. For a
# laptop or a clone of this repo with nothing plugged in that still needs the bench's
# viewpoints — detection, the world model and the Cameras tab all work as usual,
# because the frames enter at the driver layer like local ones do.
#
#   HZ_CAMERA_HOST=http://192.168.1.174:8100     # the bench's backend
#
# All-or-nothing, and it wins over CAM_* and HZ_FLEET_FILE alike: a machine either has
# the cameras or it borrows them. The slot ids must match on both ends (gripper_cam,
# overview_cam, handover_cam) — the driver tells you which ids the remote does have.
# Two limits: MJPEG carries no depth (tag distance still works, depth_m does not), and
# the far end must be reachable — see docs/CAMERA_ACCESS.md, including the fact that it
# has NO authentication, so anyone who can route to it can watch it too.
# Never point this at this same backend: it would proxy its own cameras, forever.
#HZ_CAMERA_HOST=

# --- Backend -------------------------------------------------------------
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# --- Fleet / overrides ---------------------------------------------------
# Optional: path to a JSON file that REPLACES the whole fleet (wins over the
# per-device overrides above). Leave unset to use the built-in defaults.
#HZ_FLEET_FILE=./fleet.local.json
# Optional: where UI-taught poses are persisted (default: <repo>/data/teach_poses.json).
#HZ_TEACH_POSES_FILE=./data/teach_poses.json
