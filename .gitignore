__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
*.egg-info/
.ipynb_checkpoints/

# local editor / agent settings
.claude/settings.local.json

# pitch decks and other binary exports (keep vendored PDFs like the xArm manual)
*.pptx

# frontend
node_modules/
frontend/dist/
*.tsbuildinfo
*.local

# calibration artifacts (generated)
calib/

# saved camera frames, one subfolder per camera (core/perception/capture.py). Bench-local,
# and the image volume grows without bound, so never committed.
temp/

# Bench-local data. `data/` is ignored wholesale EXCEPT the taught waypoint library:
# those poses are hours of hand-guiding a real arm, they are unreproducible without the
# bench, and nothing else backs them up. A test that escaped its isolation fixture once
# overwrote this file and five taught poses were lost for good — tracking it means the
# next such accident is a `git checkout` instead of a re-teach.
data/*
!data/teach_poses.json

# PM-agent scratch state (machine-generated)
.pm-agent/

# Locally compiled pyrealsense2 wheel — pinned to one python minor version and one CPU
# architecture, so it is not portable between machines. Regenerate with
# scripts/build_pyrealsense2_macos.sh (upstream ships no macOS wheel).
third_party/wheels/
